# ==========================================
# Pro Patch BR - Variáveis de Ambiente (.env.example)
# Todos os valores aqui são placeholders seguros.
# ==========================================

# ------------------------------------------
# 1. Banco de Dados Local & Docker Compose
# ------------------------------------------
POSTGRES_USER=propatch_user
POSTGRES_PASSWORD=seu_postgres_password_seguro
POSTGRES_DB=propatch_db
POSTGRES_PORT=5434
APP_PORT=3002

# String de conexão com o PostgreSQL (local no Mac ou container)
DATABASE_URL=postgresql://propatch_user:seu_postgres_password_seguro@127.0.0.1:5434/propatch_db

# ------------------------------------------
# 2. Autenticação e Sessão Nativa (JWT / jose)
# ------------------------------------------
# Chave secreta de no mínimo 32 caracteres para assinatura de tokens de sessão e download
AUTH_SECRET=sua_chave_secreta_jwt_minimo_32_caracteres_aleatorios

# Credenciais iniciais para o primeiro setup/seed administrativo
ADMIN_INITIAL_EMAIL=admin@propatchbr.com
ADMIN_INITIAL_PASSWORD=sua_senha_admin_inicial_segura

# ------------------------------------------
# 3. URLs da Aplicação e Comunicação
# ------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/5500000000000

# ------------------------------------------
# 4. Armazenamento Local de Patches (ISOs)
# ------------------------------------------
# Caminho absoluto no host ou no container para as ISOs protegidas
STORAGE_LOCAL_PATH=./storage/patches

# ------------------------------------------
# 5. Gateway de Pagamento (AbacatePay - PIX)
# ------------------------------------------
ABACATEPAY_API_KEY=sua_api_key_abacatepay
ABACATEPAY_WEBHOOK_SECRET=seu_webhook_secret_abacatepay
ABACATEPAY_BASE_URL=https://api.abacatepay.com/v2

# ------------------------------------------
# 6. Autenticação Google OAuth
# ------------------------------------------
GOOGLE_CLIENT_ID=seu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_google_client_secret

# ------------------------------------------
# 7. Supabase (Opcional / Compatibilidade Legada)
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_publica
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_privada
